# ==========================================
# Database & ORM
# ==========================================
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require&channel_binding=require"

# ==========================================
# Better Auth Configuration
# ==========================================
BETTER_AUTH_SECRET="your_better_auth_secret_here"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================
# Razorpay Subscriptions Integration
# ==========================================
# Razorpay API Key ID (rzp_test_... or rzp_live_...)
RAZORPAY_KEY_ID="rzp_test_TnT2q6cl5R9H83"

# Razorpay API Key Secret (Server-side ONLY; NEVER prefix with NEXT_PUBLIC_)
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# Razorpay Webhook Secret (Configured in Razorpay Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# Razorpay Plan Identifiers (Created in Razorpay Dashboard -> Subscriptions -> Plans)
# Monthly Pro Plan (₹499/mo)
RAZORPAY_PLAN_ID_PRO="plan_TnTBs97uM4cUKx"

# Monthly Premium Plan (₹999/mo)
RAZORPAY_PLAN_ID_PREMIUM="plan_TnTCQjHEYrZwjh"

# ==========================================
# Google Gemini Quick Add Parsing
# ==========================================
# Google Gemini API Key (Server-side ONLY; NEVER prefix with NEXT_PUBLIC_)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Gemini Model Identifier (Defaults to gemini-3.5-flash-lite for ultra-fast, structured extraction)
GEMINI_MODEL="gemini-3.5-flash-lite"
